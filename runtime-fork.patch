--- /dev/null
+++ b/crates/runtime/src/js/timers.rs
@@ -0,0 +1,113 @@
+//! `setTimeout`/`setInterval`, driven by worker threads that sleep and then
+//! fire the callback back on the engine thread, the same way `in_background`
+//! settles promises.
+
+use std::sync::atomic::{
+   AtomicU64,
+   Ordering,
+};
+
+use rquickjs::{
+   CatchResultExt,
+   Ctx,
+   Exception,
+   Function,
+   function::Opt,
+};
+
+use crate::js::{
+   Engine,
+   Registry,
+   drain,
+};
+
+static NEXT: AtomicU64 = AtomicU64::new(1);
+
+fn arm<'js>(
+   ctx: &Ctx<'js>,
+   callback: Function<'js>,
+   ms: u64,
+   interval: bool,
+) -> rquickjs::Result<u64> {
+   let id = NEXT.fetch_add(1, Ordering::Relaxed);
+   ctx
+      .userdata::<Registry<'js>>()
+      .ok_or_else(|| Exception::throw_internal(ctx, "no registry"))?
+      .timers
+      .borrow_mut()
+      .insert(id, (callback, interval.then_some(ms)));
+   std::thread::spawn(move || loop {
+      std::thread::sleep(std::time::Duration::from_millis(ms.max(1)));
+      let Some(engine) = crate::engine() else {
+         break;
+      };
+      if !engine.fire_timer(id) || !interval {
+         break;
+      }
+   });
+   Ok(id)
+}
+
+fn clear<'js>(ctx: &Ctx<'js>, id: Opt<u64>) -> rquickjs::Result<()> {
+   if let Some(id) = id.0 {
+      if let Some(registry) = ctx.userdata::<Registry<'js>>() {
+         registry.timers.borrow_mut().remove(&id);
+      }
+   }
+   Ok(())
+}
+
+/// `setTimeout`, `setInterval`, `clearTimeout` and `clearInterval` as globals.
+pub fn add_timer_globals<'js>(ctx: &Ctx<'js>) -> rquickjs::Result<()> {
+   let globals = ctx.globals();
+   globals.set(
+      "setTimeout",
+      Function::new(ctx.clone(), |ctx: Ctx<'js>, cb: Function<'js>, ms: Opt<u64>| {
+         arm(&ctx, cb, ms.0.unwrap_or(0), false)
+      })?,
+   )?;
+   globals.set(
+      "setInterval",
+      Function::new(ctx.clone(), |ctx: Ctx<'js>, cb: Function<'js>, ms: Opt<u64>| {
+         arm(&ctx, cb, ms.0.unwrap_or(0), true)
+      })?,
+   )?;
+   globals.set(
+      "clearTimeout",
+      Function::new(ctx.clone(), |ctx: Ctx<'js>, id: Opt<u64>| clear(&ctx, id))?,
+   )?;
+   globals.set(
+      "clearInterval",
+      Function::new(ctx.clone(), |ctx: Ctx<'js>, id: Opt<u64>| clear(&ctx, id))?,
+   )?;
+   Ok(())
+}
+
+impl Engine {
+   /// Runs timer `id`'s callback. Returns false when the timer was cleared or
+   /// is a finished one-shot, so its worker thread exits.
+   pub fn fire_timer(&self, id: u64) -> bool {
+      let repeat = self.context.with(|ctx| {
+         let Some(registry) = ctx.userdata::<Registry<'_>>() else {
+            return None;
+         };
+         let entry = registry
+            .timers
+            .borrow()
+            .get(&id)
+            .map(|(callback, interval)| (callback.clone(), *interval));
+         let Some((callback, interval)) = entry else {
+            return None;
+         };
+         if interval.is_none() {
+            registry.timers.borrow_mut().remove(&id);
+         }
+         if let Err(err) = callback.call::<_, ()>(()).catch(&ctx) {
+            log::error!("timer {id}: {err}");
+         }
+         interval
+      });
+      drain(&self.runtime);
+      repeat.is_some()
+   }
+}
