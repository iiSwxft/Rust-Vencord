+//! `phoenix.fs`, direct filesystem access for plugins that scan or manage
+//! local files. Synchronous: reads and writes run on the engine thread, which
+//! is fine for the small files these plugins touch.
+
+use std::{
+   fs,
+   path::Path,
+};
+
+use rquickjs::{
+   Ctx,
+   Function,
+   Object,
+};
+
+const B64: &[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+fn base64_encode(bytes: &[u8]) -> String {
+   let mut out = String::with_capacity(bytes.len().div_ceil(3) * 4);
+   for chunk in bytes.chunks(3) {
+      let b0 = u32::from(chunk[0]);
+      let b1 = u32::from(*chunk.get(1).unwrap_or(&0));
+      let b2 = u32::from(*chunk.get(2).unwrap_or(&0));
+      let n = (b0 << 16) | (b1 << 8) | b2;
+      out.push(B64[(n >> 18) as usize & 63] as char);
+      out.push(B64[(n >> 12) as usize & 63] as char);
+      out.push(if chunk.len() > 1 { B64[(n >> 6) as usize & 63] as char } else { '=' });
+      out.push(if chunk.len() > 2 { B64[n as usize & 63] as char } else { '=' });
+   }
+   out
+}
+
+fn io_throw(ctx: &Ctx<'_>, path: &str, err: std::io::Error) -> rquickjs::Error {
+   crate::js::throw(ctx, &crate::io_error(Path::new(path))(err))
+}
+
+fn stat_json(path: &str) -> String {
+   match fs::metadata(path) {
+      Ok(meta) => {
+         let mtime = meta
+            .modified()
+            .ok()
+            .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
+            .map_or(0, |d| d.as_millis() as u64);
+         serde_json::json!({
+            "exists": true,
+            "isDir": meta.is_dir(),
+            "isFile": meta.is_file(),
+            "size": meta.len(),
+            "mtimeMs": mtime,
+         })
+         .to_string()
+      },
+      Err(_) => serde_json::json!({ "exists": false }).to_string(),
+   }
+}
+
+fn read_dir_json(path: &str) -> Result<String, std::io::Error> {
+   let entries: Vec<serde_json::Value> = fs::read_dir(path)?
+      .filter_map(Result::ok)
+      .map(|entry| {
+         let meta = entry.metadata().ok();
+         serde_json::json!({
+            "name": entry.file_name().to_string_lossy(),
+            "isDir": meta.as_ref().is_some_and(fs::Metadata::is_dir),
+            "size": meta.as_ref().map_or(0, fs::Metadata::len),
+         })
+      })
+      .collect();
+   Ok(serde_json::to_string(&entries).unwrap_or_else(|_| "[]".to_owned()))
+}
+
+/// `phoenix.fs` for one plugin.
+pub fn fs_object<'js>(ctx: &Ctx<'js>) -> rquickjs::Result<Object<'js>> {
+   let object = Object::new(ctx.clone())?;
+
+   object.set(
+      "readText",
+      Function::new(ctx.clone(), |ctx: Ctx<'js>, path: String| {
+         match fs::read_to_string(&path) {
+            Ok(text) => Ok(text),
+            Err(err) => Err(io_throw(&ctx, &path, err)),
+         }
+      })?,
+   )?;
+
+   object.set(
+      "readBase64",
+      Function::new(ctx.clone(), |ctx: Ctx<'js>, path: String| {
+         match fs::read(&path) {
+            Ok(bytes) => Ok(base64_encode(&bytes)),
+            Err(err) => Err(io_throw(&ctx, &path, err)),
+         }
+      })?,
+   )?;
+
+   object.set(
+      "writeText",
+      Function::new(ctx.clone(), |ctx: Ctx<'js>, path: String, text: String| {
+         if let Some(parent) = Path::new(&path).parent() {
+            if let Err(err) = fs::create_dir_all(parent) {
+               return Err(io_throw(&ctx, &path, err));
+            }
+         }
+         match fs::write(&path, text) {
+            Ok(()) => Ok(()),
+            Err(err) => Err(io_throw(&ctx, &path, err)),
+         }
+      })?,
+   )?;
+
+   object.set(
+      "readDir",
+      Function::new(ctx.clone(), |ctx: Ctx<'js>, path: String| {
+         match read_dir_json(&path) {
+            Ok(json) => ctx.json_parse(json),
+            Err(err) => Err(io_throw(&ctx, &path, err)),
+         }
+      })?,
+   )?;
+
+   object.set(
+      "stat",
+      Function::new(ctx.clone(), |ctx: Ctx<'js>, path: String| ctx.json_parse(stat_json(&path)))?,
+   )?;
+
+   Ok(object)
+}
